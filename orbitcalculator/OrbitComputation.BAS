500 '          PARABOLIC ORBIT  EP = 1
510 M=MJ+(T(I)-T0)/At[1.5:C=.0364912*M:CS=SQR(C*C/4+1):Cl=C/2-CS:C2=C/2+CS:J1=SGN(C1):C1=ABS(Cl):J2=SGN(C2):C2=ABS(C2)
520 S=J1*Cl[(1/3)+J2*C2[(1/3)
530 PA=A*(1-S*S):QA=2*A*S:RETURN
600 '          ELLIPTICAL ORBIT  0 <= EP <= 0.75
610 N0=.985608/A[l.5:N0=FNRD(N0):
620 M=M0*MJ+N0*(T(I)-T0):El=M
630 E=M+EP*SIN(E1):IF ABS(1-E/El)<.0001 THEN 640 ELSE El=E:GOTO 630
640 PA=A*(COS(E)-EP):QA=A*SQR(l-EP*EP)*SIN(E):RETURN
700 '          NEARLY PARABOLIC ORBIT  .75 < EP < 1
710 E=(1-EP)/(1+EP):F=1-(.399375-.198691*E)*E
720 D=1-(.0284851-(.0186341-.001917*E)*E)*E
730 C=F*SQR((1+EP)/2)/A[1.5:B=EP*D:M=C*(T(I)-T0)+MJ
740 Tl=.0364912*M:T3=SQR(Tl*TI/4+1):X0=TI/2-T3:J1=SGN(X0):XO=ABS(X0)
750 T2=J1*X0[(1/3)+(Tl/2+T3)[(1/3):N=B*T2*T2:S=1+.431919*N
760 P=N+E:IF P<.22 THEN H=1
770 IF P>=.22 THEN H=1-3E-6*(P-.21)
780 T3=T2*S*H:T4=T3*T3*E+1
790 PA=A*(l-T3*T3)/T4:QA=2*A*T3/T4:RETURN
